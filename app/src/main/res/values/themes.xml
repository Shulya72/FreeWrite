<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ViaDesk (0.28): ночной синий, бирюза, янтарь. Имя стиля внутреннее — не меняем. -->
    <style name="Theme.FreeWrite" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#092638</item>
        <item name="android:colorPrimaryDark">#FBFCFD</item>
        <item name="android:colorAccent">#0A8F82</item>
        <item name="android:statusBarColor">#FBFCFD</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FBFCFD</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#EDF2F5</item>
    </style>

    <!-- Главный экран до первого кадра (0.29.2): светлый, как заставка при запуске (Splash.kt). В onCreate — обычная тема. -->
    <style name="Theme.FreeWrite.Launch" parent="Theme.FreeWrite">
        <item name="android:windowBackground">#EEF3F6</item>
        <item name="android:statusBarColor">#EEF3F6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#EEF3F6</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
